<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TaskManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TaskManager.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Flat command-bar buttons, as on Task Manager's page headers -->
            <Style x:Key="CommandButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="ProcessRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- Rows of every DataTable (pages other than Processes) -->
            <DataTemplate x:Key="TableRowTemplate">
                <views:TableRowView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
