<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskManager.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskManager.Views"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page title and command bar -->
        <Grid Padding="16,0,8,0">
            <TextBlock Text="Processes" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="RunNewTaskButton" Click="OnRunNewTask" Style="{StaticResource CommandButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C4;" FontSize="16" />
                        <TextBlock Text="Run new task" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="24" Margin="4,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="EndTaskButton" Click="OnEndTask" IsEnabled="False" Style="{StaticResource CommandButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                        <TextBlock Text="End task" />
                    </StackPanel>
                </Button>
                <Button x:Name="EfficiencyButton" Click="OnEfficiency" IsEnabled="False" Style="{StaticResource CommandButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEC0A;" FontSize="16" />
                        <TextBlock Text="Efficiency mode" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButtonStyle}" Padding="10,6">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem x:Name="GroupByTypeItem" Text="Group by type" Click="OnGroupByType" />
                            <MenuFlyoutSubItem x:Name="ResourceValuesItem" Text="Resource values" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Table: header + virtualized rows, scrolling sideways together -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="TableRoot" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="HeaderGrid" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" />
                <ListView x:Name="Rows" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="False"
                          SelectionChanged="OnSelectionChanged" DoubleTapped="OnRowDoubleTapped"
                          ItemContainerStyle="{StaticResource ProcessRowStyle}" Padding="0">
                    <!-- No add/move/reorder animations: rows update in place every tick. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <local:RowView />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
